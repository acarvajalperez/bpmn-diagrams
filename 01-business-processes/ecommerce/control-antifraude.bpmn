<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_Antifraud" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_Antifraude" name="Control Antifraude" isExecutable="true">
    <bpmn:startEvent id="Start_AF" name="Inicio Análisis">
      <bpmn:outgoing>Flow_AF1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:businessRuleTask id="Task_ReglasRiesgo" name="Evaluar Reglas de Riesgo">
      <bpmn:incoming>Flow_AF1</bpmn:incoming>
      <bpmn:outgoing>Flow_AF2</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:subProcess id="SubProcess_Scoring" name="Auditoría Profunda">
      <bpmn:incoming>Flow_AF2</bpmn:incoming>
      <bpmn:outgoing>Flow_AF3</bpmn:outgoing>
      <bpmn:startEvent id="Start_Sc" name="Inicio Auditoría">
        <bpmn:outgoing>Flow_Sc1</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:scriptTask id="Task_CalcScore" name="Calcular Score ML">
        <bpmn:incoming>Flow_Sc1</bpmn:incoming>
        <bpmn:outgoing>Flow_Sc2</bpmn:outgoing>
      </bpmn:scriptTask>
      <bpmn:endEvent id="End_Sc" name="Fin Auditoría">
        <bpmn:incoming>Flow_Sc2</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_Sc1" sourceRef="Start_Sc" targetRef="Task_CalcScore" />
      <bpmn:sequenceFlow id="Flow_Sc2" sourceRef="Task_CalcScore" targetRef="End_Sc" />
    </bpmn:subProcess>
    <bpmn:endEvent id="End_AF" name="Análisis Validado">
      <bpmn:incoming>Flow_AF3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_AF1" sourceRef="Start_AF" targetRef="Task_ReglasRiesgo" />
    <bpmn:sequenceFlow id="Flow_AF2" sourceRef="Task_ReglasRiesgo" targetRef="SubProcess_Scoring" />
    <bpmn:sequenceFlow id="Flow_AF3" sourceRef="SubProcess_Scoring" targetRef="End_AF" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_AF">
    <bpmndi:BPMNPlane id="BPMNPlane_AF" bpmnElement="Process_Antifraude">
      <bpmndi:BPMNShape id="Start_AF_di" bpmnElement="Start_AF">
        <dc:Bounds x="160" y="162" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ReglasRiesgo_di" bpmnElement="Task_ReglasRiesgo">
        <dc:Bounds x="260" y="140" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SubProcess_Scoring_di" bpmnElement="SubProcess_Scoring" isExpanded="false">
        <dc:Bounds x="450" y="140" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_Sc_di" bpmnElement="Start_Sc">
        <dc:Bounds x="200" y="162" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_CalcScore_di" bpmnElement="Task_CalcScore">
        <dc:Bounds x="300" y="140" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Sc_di" bpmnElement="End_Sc">
        <dc:Bounds x="480" y="162" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_Sc1_di" bpmnElement="Flow_Sc1">
        <di:waypoint x="236" y="180" />
        <di:waypoint x="300" y="180" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Sc2_di" bpmnElement="Flow_Sc2">
        <di:waypoint x="420" y="180" />
        <di:waypoint x="480" y="180" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="End_AF_di" bpmnElement="End_AF">
        <dc:Bounds x="640" y="162" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_AF1_di" bpmnElement="Flow_AF1">
        <di:waypoint x="196" y="180" />
        <di:waypoint x="260" y="180" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_AF2_di" bpmnElement="Flow_AF2">
        <di:waypoint x="380" y="180" />
        <di:waypoint x="450" y="180" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_AF3_di" bpmnElement="Flow_AF3">
        <di:waypoint x="570" y="180" />
        <di:waypoint x="640" y="180" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
