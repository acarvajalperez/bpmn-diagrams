<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_LangGraph"
                  targetNamespace="http://bpmn.io/schema/bpmn"
                  exporter="Camunda Modeler"
                  exporterVersion="5.0.0">

  <!-- ======================================================== -->
  <!-- LÓGICA DEL PROCESO BPMN                                  -->
  <!-- ======================================================== -->
  <bpmn:process id="LangGraph_Agent_Process" name="LangGraph AI Agent Execution Loop" isExecutable="true">
    
    <!-- Inicio del Proceso -->
    <bpmn:startEvent id="Start_Input" name="Recibir Prompt / User Message">
      <bpmn:outgoing>Flow_01</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Inicialización del Estado -->
    <bpmn:scriptTask id="Task_Init_State" name="Inicializar AgentState (messages, config)">
      <bpmn:incoming>Flow_01</bpmn:incoming>
      <bpmn:outgoing>Flow_02</bpmn:outgoing>
    </bpmn:scriptTask>

    <!-- Nodo del Modelo LLM -->
    <bpmn:serviceTask id="Task_Call_LLM" name="Ejecutar LLM Node (call_model)">
      <bpmn:incoming>Flow_02</bpmn:incoming>
      <bpmn:incoming>Flow_Loop_Back</bpmn:incoming>
      <bpmn:outgoing>Flow_03</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Gateway Condicional (Router / Conditional Edge) -->
    <bpmn:exclusiveGateway id="Gateway_Should_Continue" name="¿Router: should_continue?">
      <bpmn:incoming>Flow_03</bpmn:incoming>
      <bpmn:outgoing>Flow_To_Tools</bpmn:outgoing>
      <bpmn:outgoing>Flow_To_End</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Nodo de Herramientas (ToolNode) -->
    <bpmn:serviceTask id="Task_Execute_Tools" name="Ejecutar ToolNode (execute_tools)">
      <bpmn:incoming>Flow_To_Tools</bpmn:incoming>
      <bpmn:outgoing>Flow_04</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Actualización de Estado (Reducer) -->
    <bpmn:scriptTask id="Task_Update_State" name="Actualizar AgentState (Append ToolMessage)">
      <bpmn:incoming>Flow_04</bpmn:incoming>
      <bpmn:outgoing>Flow_Loop_Back</bpmn:outgoing>
    </bpmn:scriptTask>

    <!-- Fin del Proceso -->
    <bpmn:endEvent id="End_Response" name="Retornar AI Response (END)">
      <bpmn:incoming>Flow_To_End</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Flujos de Secuencia -->
    <bpmn:sequenceFlow id="Flow_01" sourceRef="Start_Input" targetRef="Task_Init_State" />
    <bpmn:sequenceFlow id="Flow_02" sourceRef="Task_Init_State" targetRef="Task_Call_LLM" />
    <bpmn:sequenceFlow id="Flow_03" sourceRef="Task_Call_LLM" targetRef="Gateway_Should_Continue" />
    
    <!-- Arista Condicional 1: Se requieren herramientas -->
    <bpmn:sequenceFlow id="Flow_To_Tools" name="Tool Calls Presentes" sourceRef="Gateway_Should_Continue" targetRef="Task_Execute_Tools">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"><![CDATA[${state.messages.last().tool_calls.size() > 0}]]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    
    <!-- Arista Condicional 2: Respuesta final generada -->
    <bpmn:sequenceFlow id="Flow_To_End" name="Sin Tool Calls / Final response" sourceRef="Gateway_Should_Continue" targetRef="End_Response">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"><![CDATA[${state.messages.last().tool_calls.size() == 0}]]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Bucle de retroalimentación hacia el LLM -->
    <bpmn:sequenceFlow id="Flow_04" sourceRef="Task_Execute_Tools" targetRef="Task_Update_State" />
    <bpmn:sequenceFlow id="Flow_Loop_Back" sourceRef="Task_Update_State" targetRef="Task_Call_LLM" />

  </bpmn:process>

  <!-- ======================================================== -->
  <!-- INFORMACIÓN DE VISUALIZACIÓN (BPMNDI)                    -->
  <!-- ======================================================== -->
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="LangGraph_Agent_Process">
      
      <!-- Start Event -->
      <bpmndi:BPMNShape id="Start_Input_di" bpmnElement="Start_Input">
        <dc:Bounds x="160" y="120" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="138" y="163" width="80" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- Init State Task -->
      <bpmndi:BPMNShape id="Task_Init_State_di" bpmnElement="Task_Init_State">
        <dc:Bounds x="250" y="98" width="120" height="80" />
      </bpmndi:BPMNShape>

      <!-- Call LLM Task -->
      <bpmndi:BPMNShape id="Task_Call_LLM_di" bpmnElement="Task_Call_LLM">
        <dc:Bounds x="420" y="98" width="120" height="80" />
      </bpmndi:BPMNShape>

      <!-- Gateway Should Continue -->
      <bpmndi:BPMNShape id="Gateway_Should_Continue_di" bpmnElement="Gateway_Should_Continue" isMarkerVisible="true">
        <dc:Bounds x="595" y="113" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="578" y="76" width="84" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- Execute Tools Task -->
      <bpmndi:BPMNShape id="Task_Execute_Tools_di" bpmnElement="Task_Execute_Tools">
        <dc:Bounds x="560" y="230" width="120" height="80" />
      </bpmndi:BPMNShape>

      <!-- Update State Task -->
      <bpmndi:BPMNShape id="Task_Update_State_di" bpmnElement="Task_Update_State">
        <dc:Bounds x="380" y="230" width="120" height="80" />
      </bpmndi:BPMNShape>

      <!-- End Response Event -->
      <bpmndi:BPMNShape id="End_Response_di" bpmnElement="End_Response">
        <dc:Bounds x="712" y="120" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="691" y="163" width="79" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- Connection: Start -> Init -->
      <bpmndi:BPMNEdge id="Flow_01_di" bpmnElement="Flow_01">
        <di:waypoint x="196" y="138" />
        <di:waypoint x="250" y="138" />
      </bpmndi:BPMNEdge>

      <!-- Connection: Init -> Call LLM -->
      <bpmndi:BPMNEdge id="Flow_02_di" bpmnElement="Flow_02">
        <di:waypoint x="370" y="138" />
        <di:waypoint x="420" y="138" />
      </bpmndi:BPMNEdge>

      <!-- Connection: Call LLM -> Gateway -->
      <bpmndi:BPMNEdge id="Flow_03_di" bpmnElement="Flow_03">
        <di:waypoint x="540" y="138" />
        <di:waypoint x="595" y="138" />
      </bpmndi:BPMNEdge>

      <!-- Connection: Gateway -> Tools -->
      <bpmndi:BPMNEdge id="Flow_To_Tools_di" bpmnElement="Flow_To_Tools">
        <di:waypoint x="620" y="163" />
        <di:waypoint x="620" y="230" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="625" y="180" width="53" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <!-- Connection: Gateway -> End -->
      <bpmndi:BPMNEdge id="Flow_To_End_di" bpmnElement="Flow_To_End">
        <di:waypoint x="645" y="138" />
        <di:waypoint x="712" y="138" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="643" y="106" width="67" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <!-- Connection: Tools -> Update State -->
      <bpmndi:BPMNEdge id="Flow_04_di" bpmnElement="Flow_04">
        <di:waypoint x="560" y="270" />
        <di:waypoint x="500" y="270" />
      </bpmndi:BPMNEdge>

      <!-- Connection: Update State -> Loop Back to LLM -->
      <bpmndi:BPMNEdge id="Flow_Loop_Back_di" bpmnElement="Flow_Loop_Back">
        <di:waypoint x="440" y="230" />
        <di:waypoint x="440" y="178" />
      </bpmndi:BPMNEdge>

    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>

</bpmn:definitions>
