    <bpmn2:scriptTask id="_649A9DC9-17BB-45EC-835B-A70E61DAE056" name="Inicializar colección" scriptFormat="http://www.java.com/java">
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[Inicializar colección]]></drools:metaValue>
        </drools:metaData>
      </bpmn2:extensionElements>
      <bpmn2:incoming>_5D521D95-12EC-4FCB-99E9-BE80F9C57609</bpmn2:incoming>
      <bpmn2:outgoing>_FC633AD7-6800-4A01-AB51-BC20B12D24DA</bpmn2:outgoing>
      <bpmn2:script><![CDATA[java.text.SimpleDateFormat sdf = new java.text.SimpleDateFormat("yyyy-MM-dd HH:mm:ss.SSS");
String fechaHora = sdf.format(new java.util.Date());
System.out.println("*** INICIO - Inicializar colección: " + fechaHora);

java.util.List<com.espacio1.proyecto1.Empleado> empleados2 = (java.util.List<com.espacio1.proyecto1.Empleado>) kcontext.getVariable("Empleados");

if (empleados2 == null) {
    empleados2 = new java.util.ArrayList<com.espacio1.proyecto1.Empleado>();
}

for (long i = 0; i < 1000; i++)
    empleados2.add(new com.espacio1.proyecto1.Empleado("empleado" + i));

kcontext.setVariable("empleados", empleados2);

fechaHora = sdf.format(new java.util.Date());
System.out.println("*** FIN - Inicializar colección: " + fechaHora);]]></bpmn2:script>
    </bpmn2:scriptTask>
